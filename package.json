{
  "name": "dealflow-crm-new",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose down && docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @dealflow/api",
    "db:migrate": "npm run db:migrate -w @dealflow/api",
    "dev": "concurrently -n api,web -c blue,magenta npm:dev:api npm:dev:web",
    "dev:api": "npm run dev -w @dealflow/api",
    "dev:web": "npm run dev -w @dealflow/web",
    "dev:cloud": "npm run dev:cloud -w @dealflow/web"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
